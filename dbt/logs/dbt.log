  create  table "aiacademy"."korgonbaeva_datamart"."dm_daily_air_quality__dbt_tmp"
  
  
    as
  
  (
    
select ds, count(*) as measurement_count, sum(value)::numeric(20,4) as value_sum,
       round(avg(value),4)::numeric(14,4) as mean_value,
